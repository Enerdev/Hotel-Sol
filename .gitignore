node_modules/
.pnp
.pnp.js

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Variables de entorno (NUNCA subir a Git)
.env
.env.local
.env.development
.env.production
.env.test
*.env
!.env.example

# Builds
dist/
build/
out/
plesk-httpdocs/
.next/
.nuxt/

# Cache
.cache/
.parcel-cache/
.eslintcache
.vite/
.turbo/

# Coverage / testing
coverage/
*.lcov
.nyc_output/

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Sistema operativo
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# TypeScript
*.tsbuildinfo

# Backend
backend/uploads/
backend/temp/
backend/tmp/

# Frontend
frontend/dist/
frontend/.vite/

# Frontend copiado dentro del backend (se genera en el build unificado)
backend/public/

# Backups de BD
*.sql.bak
*.dump
database/backups/

# Otros
.history/
*.bak
*.orig
*.rej
