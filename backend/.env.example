# ============================================================================
# VARIABLES DE ENTORNO - HOTEL BACKEND
# ============================================================================
# Copia este archivo como .env (sin el .example) y rellena los valores reales.
# Nunca subas .env a Git (está en .gitignore).
# ============================================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Base de datos MySQL (XAMPP por defecto) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lapreperu_hotel

# --- JWT (autenticación) ---
# IMPORTANTE: cambia estos valores por strings aleatorios largos en producción.
# Puedes generar uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambiar_esto_por_un_string_aleatorio_largo_minimo_32_caracteres
JWT_REFRESH_SECRET=cambiar_esto_por_otro_string_diferente_tambien_largo
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Bcrypt ---
BCRYPT_ROUNDS=10
