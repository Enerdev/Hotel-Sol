{
  "name": "hotel-system-backend",
  "version": "0.1.0",
  "description": "API REST + WebSockets para el sistema de gestión hotelera",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "seed:passwords": "tsx src/scripts/seedPasswords.ts",
    "test:db": "tsx src/scripts/testDb.ts",
    "deploy:plesk": "cd .. && npm install && npm run build"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5",
    "socket.io": "^4.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
