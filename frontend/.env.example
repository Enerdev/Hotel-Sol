# ============================================================================
# VARIABLES DE ENTORNO - HOTEL FRONTEND
# ============================================================================
# Copia este archivo como .env (sin el .example) y rellena los valores reales.
# Nunca subas .env a Git (está en .gitignore).
# ============================================================================

# URL del backend API (debe estar corriendo el backend)
VITE_API_URL=http://localhost:3000/api

# URL del backend Socket.IO (para tiempo real)
VITE_SOCKET_URL=http://localhost:3000
